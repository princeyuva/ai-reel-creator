    {
      "parameters": {
        "jsCode": "const plan = $input.first().json;\nlet edit = plan.content;\nif (typeof edit === 'string') { try { edit = JSON.parse(edit); } catch (e) { edit = {}; } }\nif (!edit || typeof edit !== 'object') { edit = {}; }\nconst timeline = edit.timeline || edit;\nconst body = {\n  timeline: timeline,\n  output: { format: 'mp4', fps: 30, size: { width: 1080, height: 1920 } }\n};\nreturn [{ json: { renderBody: body } }];"
      },
