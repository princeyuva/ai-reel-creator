      "parameters": {
        "jsCode": "function grab(name){\n  try {\n    const it = $(name).first().json;\n    return it.content || it.text || '';\n  } catch (e) { return ''; }\n}\nconst photos = grab('Analyze Photos');\nconst videos = grab('Analyze Videos');\nreturn [{ json: {\n  mediaAnalysis: 'PHOTOS:\\n' + JSON.stringify(photos) + '\\n\\nVIDEOS:\\n' + JSON.stringify(videos)\n} }];"
      },
      "id": "5c6863b1-c476-45a8-92a5-be4a00120f5b",
      "name": "Consolidate Media Analysis",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        480
      ]
