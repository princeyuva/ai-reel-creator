            {
              "fieldLabel": "Or upload a reference video (optional)",
              "fieldType": "file",
              "fieldName": "reference_video",
              "multipleFiles": false,
              "acceptFileTypes": ".mp4,.mov,.webm"
            },
            {
              "fieldLabel": "Your trip photos & videos — public direct URLs, one per line",
              "fieldType": "textarea",
              "fieldName": "trip_media_urls",
              "placeholder": "https://.../beach.jpg\nhttps://.../surf.mp4",
              "requiredField": true
            },
            {
              "fieldLabel": "Editing instructions (optional)",
              "fieldType": "textarea",
              "fieldName": "edit_instructions",
              "placeholder": "e.g. make it cinematic, faster cuts, remove text, use more photos"
            },
            {
              "fieldLabel": "Target duration (seconds)",
              "fieldType": "number",
              "fieldName": "target_duration",
              "placeholder": "20"
            },
            {
              "fieldLabel": "Email to send the finished Reel to",
              "fieldType": "email",
              "fieldName": "email",
              "requiredField": true
            }
          ]
        },
        "options": {}
