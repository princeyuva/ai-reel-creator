    {
      "parameters": {
        "jsCode": "const items = $input.all();\nlet recipe = '';\nfor (const it of items) {\n  const c = it.json.content || it.json.text || '';\n  const s = ('' + c);\n  if (s.length > recipe.length) { recipe = s; }\n}\nreturn [{ json: { referenceRecipe: recipe || 'No reference analysis available; use a generic energetic 15s travel montage structure.' } }];"
      },
      "id": "23aeba20-985b-4892-9745-c23e9de3d49f",
      "name": "Reference Recipe",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        96
      ]
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "options": {}
      },
      "id": "05a79114-2011-434c-9c89-c44987284af1",
      "name": "Combine Analysis",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        1344,
        288
      ]
    },
    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst raw = (j.trip_media_urls || '').toString();\nconst urls = raw.split(/\\r?\\n/).map(s => s.trim()).filter(s => s.length > 0);\nconst imageExt = ['jpg','jpeg','png','gif','webp','heic','bmp'];\nconst images = [];\nconst videos = [];\nfor (const u of urls) {\n  const clean = u.split('?')[0].toLowerCase();\n  const dot = clean.lastIndexOf('.');\n  const ext = dot >= 0 ? clean.slice(dot + 1) : '';\n  if (imageExt.indexOf(ext) >= 0) { images.push(u); } else { videos.push(u); }\n}\nconst dur = parseInt(j.target_duration, 10);\nreturn [{ json: {\n  allMediaUrls: urls,\n  imageUrls: images,\n  videoUrls: videos,\n  imageUrlsCsv: images.join(','),\n  videoUrlsCsv: videos.join(','),\n  mediaCount: urls.length,\n  targetDuration: isNaN(dur) ? 20 : dur,\n  instructions: (j.edit_instructions || '').toString(),\n  email: j.email || '',\n  referenceLink: (j.reference_reel_link || '').toString()\n}}];"
      },
